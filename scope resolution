#include <iostream>
using namespace std;

class Rectangle{
    public:
    int length;
    int width;
    
    Rectangle (int ,int);
    void area();
};
Rectangle::Rectangle(int l,int w){
    length=l;
    width=w;
}
void Rectangle::area(){
    cout<<"area of rectangle is : "<<length*width<<endl;
}
int main(){
    Rectangle r1(8,4);
    r1.area();
}
