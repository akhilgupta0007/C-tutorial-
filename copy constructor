# include <iostream>
using namespace std;

class Rectangle{
    public:
    int length;
    int width;
    
    Rectangle(int l,int w){
        length=l;
        width=w;
    }
    void Area(){
        cout<<"Area of rectangle is "<<length*width<<endl;
    }
};
int main(){
    Rectangle r1(10,5);
    r1.Area();
    Rectangle r3(5,4);
    r3.Area();
    Rectangle r2=r1;
    r2.Area();
}
