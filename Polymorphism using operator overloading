#include <iostream>
using namespace std;

class Student{
    public :
    int age;
    Student operator +(Student obj){
        Student temp;
        temp.age=age+obj.age;
        return temp;
    }
    bool operator>(Student obj){
        if (age>obj.age){
            return true;
        }
        else{
            return false;
        }
    }    
};
int main (){
    Student s1,s2;
    s1.age=10;
    s2.age=20;
    
    Student s3=s1+s2;
    cout <<s3.age<<endl;
    
    if (s1>s2){
        cout<<"s1 is old";
    }
    else{
        cout<<"s2 is old";
    }
    
    
}
