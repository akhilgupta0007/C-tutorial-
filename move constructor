#include <iostream>
using namespace std;

class Rectangle{
    public :
    int length ;
    int breadth ;
     
    Rectangle (int l,int b){
        length=l;
        breadth=b;
    }
    Rectangle(Rectangle &&obj){
        length=move(obj.length);
        breadth=move(obj.breadth);
        obj.length=0;
        obj.breadth=0;
    }
    void area(){
        cout<<"area of rectangle is :"<<length*breadth<<endl;
    }
};
int main(){
    Rectangle r1(10,8);
    r1.area();
    Rectangle r2(5,4);
    r2.area();
    r1.area();
    
    return 0;
}
